{
  "manifest_version": 2,
  "name": "Weiktube Home data connection",
  "version": "1.0.1",
  "browser_specific_settings": { "gecko": { "id": "home-data@weiktube.local" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
    "js": ["bridge.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
